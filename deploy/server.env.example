KTOR_HOST=0.0.0.0
KTOR_SSL_PORT=8443
PUBLIC_DOMAIN=chat.example.org
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_AGREE_TOS=false
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/secure_messenger
DATABASE_USER=messenger
DATABASE_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME
TOKEN_PEPPER_BASE64=CHANGE_ME
MEDIA_STORAGE_PATH=/var/lib/secure-messenger/media
TLS_KEYSTORE_PATH=/etc/secure-messenger/tls/server.p12
TLS_KEY_ALIAS=messenger
TLS_KEYSTORE_PASSWORD=CHANGE_ME
TLS_PRIVATE_KEY_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=messenger@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
